{
	"cli": {
		"version": ">= 19.0.0",
		"appVersionSource": "remote",
		"requireCommit": true
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development"
		},
		"preview": {
			"distribution": "internal",
			"environment": "preview",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"autoIncrement": true,
			"environment": "production",
			"android": {
				"buildType": "app-bundle"
			}
		}
	},
	"submit": {
		"production": {}
	}
}

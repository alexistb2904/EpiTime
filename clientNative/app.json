{
	"expo": {
		"name": "EpiTime",
		"slug": "epitime",
		"scheme": "epitime",
		"version": "1.2.0",
		"orientation": "portrait",
		"icon": "./assets/app_logo.png",
		"userInterfaceStyle": "automatic",
		"android": {
			"package": "fr.alexistb2904.epitime",
			"icon": "./assets/app_logo.png",
			"googleServicesFile": "./google-services.json",
			"adaptiveIcon": {
				"foregroundImage": "./assets/epitime_app_adaptive.png",
				"backgroundColor": "#FFFFFF"
			},
			"permissions": [
				"POST_NOTIFICATIONS",
				"POST_PROMOTED_NOTIFICATIONS",
				"SCHEDULE_EXACT_ALARM",
				"REQUEST_INSTALL_PACKAGES"
			]
		},
		"plugins": [
			"expo-secure-store",
			[
				"expo-notifications",
				{
					"color": "#023C69",
					"defaultChannel": "courses"
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash_logo.png",
					"imageWidth": 180,
					"resizeMode": "contain",
					"backgroundColor": "#F2F4F8",
					"dark": {
						"image": "./assets/splash_logo.png",
						"backgroundColor": "#0F1115"
					}
				}
			]
		],
		"extra": {
			"eas": {
				"projectId": "19303643-730f-48a3-9cc5-811f9be90e77"
			}
		},
		"owner": "alexistb2904"
	}
}

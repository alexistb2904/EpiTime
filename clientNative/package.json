{
	"name": "epitime-native-front",
	"version": "1.2.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"start": "npx expo start",
		"preandroid": "node scripts/prepare-google-services.js",
		"android": "npx expo run:android --app-id fr.alexistb2904.epitime.dev",
		"prebuild": "npx expo prebuild --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test src/**/*.test.mjs scripts/*.test.mjs",
		"test:groups": "node --experimental-strip-types --test src/utils/groups.test.mjs",
		"test:filters": "node --experimental-strip-types --test src/utils/scheduleFilters.test.mjs",
		"test:version": "node --experimental-strip-types --test src/services/versionUtils.test.mjs",
		"doctor": "npx expo-doctor",
		"apk:cloud": "npm run build:android:development",
		"apk": "npm run apk:build && npm run apk:copy",
		"apkLinux": "npm run apk",
		"apk:build": "npm run release:check && node scripts/prepare-google-services.js --require && node scripts/build-android-release.js",
		"apkLinux:build": "npm run apk:build",
		"apk:clean": "node scripts/build-android-release.js clean",
		"apk:copy": "node scripts/verify-android-release.js --artifact && node scripts/copy-release-artifacts.js",
		"apk:rebuild": "npm run apk:clean && npm run apk",
		"release:check": "node scripts/verify-android-release.js",
		"eas-build-pre-install": "node scripts/prepare-google-services.js --require && node scripts/verify-android-release.js",
		"test:google-services": "node --test scripts/prepare-google-services.test.mjs",
		"eas:sync-public-env": "node scripts/sync-eas-public-env.js",
		"build:android": "npm run build:android:production",
		"build:android:development": "eas build --platform android --profile development",
		"build:android:preview": "eas build --platform android --profile preview",
		"build:android:production": "eas build --platform android --profile production",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-navigation/bottom-tabs": "^7.21.0",
		"@react-navigation/native": "^7.5.1",
		"@rybbit/react-native": "^0.1.1",
		"babel-preset-expo": "~58.0.0",
		"expo": "^58.0.0",
		"expo-asset": "~58.0.21",
		"expo-auth-session": "~58.0.18",
		"expo-background-task": "~58.0.13",
		"expo-constants": "~58.0.16",
		"expo-dev-client": "~58.0.20",
		"expo-device": "~58.0.5",
		"expo-document-picker": "~58.0.5",
		"expo-file-system": "~58.0.13",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.17",
		"expo-notifications": "~58.1.9",
		"expo-print": "~58.0.9",
		"expo-secure-store": "~58.0.3",
		"expo-splash-screen": "~58.0.14",
		"expo-status-bar": "~58.0.5",
		"expo-task-manager": "~58.0.14",
		"expo-web-browser": "~58.0.8",
		"lucide-react-native": "^1.72.0",
		"phosphor-react-native": "^3.0.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-android-widget": "^0.26.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0"
	},
	"devDependencies": {
		"@types/react": "~19.3.0",
		"patch-package": "^8.0.1",
		"typescript": "6.0.3"
	},
	"expo": {
		"doctor": {
			"appConfigFieldsNotSyncedCheck": {
				"enabled": false
			}
		}
	}
}
